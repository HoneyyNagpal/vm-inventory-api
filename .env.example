# Copy to .env and adjust. Defaults match a local vcsim started with:
#   docker run -p 8989:8989 vmware/vcsim
VCENTER_HOST=localhost
VCENTER_PORT=8989
VCENTER_USER=user
VCENTER_PASSWORD=pass
VCENTER_VERIFY_SSL=false

# Real vCenter example:
# VCENTER_HOST=vcenter.example.com
# VCENTER_PORT=443
# VCENTER_USER=readonly@vsphere.local
# VCENTER_PASSWORD=...
# VCENTER_VERIFY_SSL=true

# Leave empty to disable API key auth (local demos only).
API_KEY=
